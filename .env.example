# Nebius Token Factory
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Optional global override. Leave blank to use the three-tier Nemotron strategy below.
NEBIUS_MODEL=

# Models confirmed available in the hackathon Token Factory account on 2026-09-17.
NEBIUS_MODEL_TRIAGE=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_STANDARD=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_DEEP=nvidia/Nemotron-3-Ultra-550b-a55b

# Optional path to a live Resource Shield status.json when running on CWP7.
# Leave blank to use the included anonymized demo incident.
RESOURCE_SHIELD_STATUS_PATH=

# Set to 1 to allow demo fallback output when no Nebius key is configured.
DEMO_FALLBACK=1
